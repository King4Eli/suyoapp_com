  "version": "0.2.0",
  "configurations": [
    {
      "name": "npm start",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm start",
      "cwd": "${workspaceFolder}/mobile"
    },
    {
      "name": "run-android",
      "type": "node-terminal",
      "request": "launch",
      "command": "npx react-native run-android", //"npm run build:android",
      "cwd": "${workspaceFolder}/mobile"
    },
    {
      "name": "run-ios",
      "type": "node-terminal",
      "request": "launch",
      "command": "npx react-native run-ios",
      "cwd": "${workspaceFolder}/mobile"
    },
    {
      "name": "build ios release",
      "type": "node-terminal",
      "request": "launch",
      "command": "npx react-native run-ios --mode Release",
      "cwd": "${workspaceFolder}/mobile"
    },
    {
      "name": "apk - build",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run build:apk",
      "cwd": "${workspaceFolder}/mobile"
    }
  ]
}
