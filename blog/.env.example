# Copy this file to .env and fill in the values before starting the worker.
#
# MySQL server Ghost connects to (must already exist and be reachable).
GHOST_DB_USER=
GHOST_DB_PASSWORD=
GHOST_DB_NAME=
#
# Start Ghost first with:
# docker compose up -d fkb_ghost
#
# Then open http://localhost:8080/ghost/ to complete the setup wizard. Go to
# Settings > Integrations > Add custom integration, name it (e.g. "AI Worker"),
# and copy its "Admin API Key" here.
#
# Start the worker after setting the key with:
# docker compose --profile worker up -d
#
# It looks like: 507f1f77bcf86cd799439011:64charhexsecret...
GHOST_ADMIN_API_KEY=

# Optional: enables feature images on posts via the Pexels API.
# Get a free key at https://www.pexels.com/api/ (instant approval).
# Without it, posts are published without a feature image.
PEXELS_API_KEY=
