# Redis-backed rate limits and OTP/code timeouts. Each var has an in-code default
# (api_v1/global/functions.js:envInt); only list overrides here.

# Login
LOGIN_IP_LIMIT=30
LOGIN_IP_WINDOW_SECONDS=600
LOGIN_OTP_REQUEST_LIMIT=5
LOGIN_OTP_REQUEST_WINDOW_SECONDS=600
LOGIN_OTP_VERIFY_LIMIT=10
LOGIN_OTP_VERIFY_WINDOW_SECONDS=600
LOGIN_OTP_CODE_TTL_SECONDS=600

# Signup
SIGNUP_IP_LIMIT=30
SIGNUP_IP_WINDOW_SECONDS=600
SIGNUP_OTP_REQUEST_LIMIT=5
SIGNUP_OTP_REQUEST_WINDOW_SECONDS=600
SIGNUP_OTP_VERIFY_LIMIT=10
SIGNUP_OTP_VERIFY_WINDOW_SECONDS=600
SIGNUP_OTP_CODE_TTL_SECONDS=600

# Phone number change
PHONECHANGE_OTP_REQUEST_LIMIT=5
PHONECHANGE_OTP_REQUEST_WINDOW_SECONDS=600
PHONECHANGE_OTP_VERIFY_LIMIT=10
PHONECHANGE_OTP_VERIFY_WINDOW_SECONDS=600
PHONECHANGE_OTP_CODE_TTL_SECONDS=300

# Email change
EMAILCHANGE_OTP_REQUEST_LIMIT=5
EMAILCHANGE_OTP_REQUEST_WINDOW_SECONDS=600
EMAILCHANGE_OTP_VERIFY_LIMIT=10
EMAILCHANGE_OTP_VERIFY_WINDOW_SECONDS=600
EMAILCHANGE_OTP_CODE_TTL_SECONDS=300

# Likes free tier -- shared by enforcement (pushPeopleToMatch.js) and the remaining-today display (getProfile.js)
LIKES_DAILY_FREE_LIMIT=20
LIKES_DAILY_WINDOW_SECONDS=86400
