# Local LLM for conversation starters (docker-compose service suyoapp_com_llm)
LLM_URL=http://suyoapp_com_llm:11434
# qwen2.5:3b writes noticeably better starters than 1.5b (~2GB RAM vs ~1GB);
# use qwen2.5:1.5b on a small box.
LLM_MODEL=qwen2.5:3b
# How long the API waits for one generation before using the fallback ideas
LLM_TIMEOUT_MS=25000
