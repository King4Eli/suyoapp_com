# Native IAP verification. Blank = pseudo/dev-trust mode (api_v1/global/iapVerify.js), ok for
# sandbox/internal testing; required in production (NODE_ENV=production refuses pseudo mode).

# App Store Connect API key
APPLE_APP_STORE_KEY_ID=
APPLE_APP_STORE_ISSUER_ID=
APPLE_APP_STORE_PRIVATE_KEY=
APPLE_BUNDLE_ID=ccom.example.app

# Google Play service account with Play Developer API access (client_email/private_key from its JSON key)
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PLAY_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_PLAY_PACKAGE_NAME=com.example.app
